{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technical short scene specification",
  "type": "object",
  "required": ["title", "slug", "duration", "aspect_ratio", "fps", "key_message", "objects", "scenes"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
    "aspect_ratio": {"const": "9:16"},
    "fps": {"type": "integer", "minimum": 12, "maximum": 60},
    "key_message": {"type": "string", "minLength": 1},
    "objects": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "type"], "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "type": {"type": "string", "minLength": 1}
      }, "additionalProperties": false}
    },
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "duration", "narration", "visual_goal", "camera", "visible_objects", "animation", "labels", "transition"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "start": {"type": "number", "minimum": 0},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "narration": {"type": "string"},
          "visual_goal": {"type": "string", "minLength": 1},
          "camera": {"type": "object", "required": ["type", "movement"], "properties": {
            "type": {"enum": ["orthographic", "perspective"]},
            "movement": {"enum": ["static_iso", "slow_dolly_in", "slow_dolly_out", "orbit", "tilt_down", "scene_camera", "keyframes"]},
            "camera_name": {"type": "string", "minLength": 1},
            "interpolation": {"enum": ["LINEAR", "BEZIER", "CONSTANT"]},
            "keyframes": {"type": "array", "minItems": 2, "items": {
              "type": "object", "required": ["t", "location", "target"], "properties": {
                "t": {"type": "number", "minimum": 0, "maximum": 1},
                "location": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                "target": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                "lens_mm": {"type": "number", "exclusiveMinimum": 0},
                "ortho_scale": {"type": "number", "exclusiveMinimum": 0}
              }, "additionalProperties": false
            }}
          }, "additionalProperties": false,
          "allOf": [
            {"if": {"properties": {"movement": {"const": "scene_camera"}}}, "then": {"required": ["camera_name"]}},
            {"if": {"properties": {"movement": {"const": "keyframes"}}}, "then": {"required": ["keyframes"]}}
          ]},
          "visible_objects": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "animation": {"type": "object", "required": ["type"], "properties": {
            "type": {"enum": ["none", "cutaway_reveal", "exploded_view", "flow", "assemble"]},
            "axis": {"enum": ["x", "y", "z"]},
            "distance": {"type": "number", "minimum": 0}
          }, "additionalProperties": false},
          "labels": {"type": "array", "items": {"type": "string"}},
          "transition": {"enum": ["cut", "end"]},
          "source": {"enum": ["blender", "image", "video"]},
          "media": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
