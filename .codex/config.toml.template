model = "gpt-6-astra"

[agents]
enabled = true
max_concurrent_threads_per_session = 3
default_subagent_model = "gpt-6.1-sol"
default_subagent_reasoning_effort = "high"

# Typed Blender workbench (studio/workbench_mcp.py). exec is never exposed; commits replay through shot build.
[mcp_servers.studio_workbench]
# Generated by scripts/bootstrap.sh with absolute paths (the MCP launcher working directory is not guaranteed).
command = "@PYTHON@"
args = ["-m", "studio.workbench_mcp"]
cwd = "@ROOT@"
tool_timeout_sec = 3600
startup_timeout_sec = 20
enabled_tools = ["workbench_start", "workbench_call", "workbench_compare", "workbench_commit", "workbench_stop", "studio_run"]
# Blender cannot start inside the codex sandbox (no GPU); this server runs it outside, in the studio's own sandbox
# (studio/broker.py: no network, no API keys, writes only in the repository), so its tools need no per-call prompt.
default_tools_approval_mode = "approve"
