{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Decision layers settled with the user before expensive work (studio/decisions.py). Each layer body is closed: an edit to a path the schema does not define is refused.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "audience",
        "length_s",
        "key_message",
        "subject_mode"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 3
        },
        "audience": {
          "type": "string",
          "minLength": 2
        },
        "length_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "tone": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "key_message": {
          "type": "string",
          "minLength": 3
        },
        "subject_mode": {
          "enum": [
            "specific_real",
            "schematic",
            "fictional"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "take": {
                "type": "string"
              }
            }
          }
        },
        "must_include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "place": {
          "type": "string",
          "minLength": 3,
          "description": "where the story happens, in words (decided before the camera); generate backdrop-review --shot uses it when no --place is given"
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "claims"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "title"
            ],
            "properties": {
              "source_id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "citation": {
                "type": "string"
              },
              "retrieved_at": {
                "type": "string"
              },
              "excerpt": {
                "type": "string"
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "text",
              "source_ids"
            ],
            "properties": {
              "claim_id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 3
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "about": {
                "type": "array",
                "description": "what the claim is about, so what a line that says it must show: a world element id, a subject id, subject/part_id or subject/feature_id (a spec feature: any of its parts). [] when it explains nothing that can be seen (studio/explains.py)",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_.-]*(/[a-z0-9][a-z0-9_.-]*)?$"
                }
              }
            }
          }
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines"
      ],
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line_id",
              "text"
            ],
            "properties": {
              "line_id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "illustrative": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        },
        "chars_per_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "shotlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shots"
      ],
      "properties": {
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shot_id",
              "purpose",
              "line_ids",
              "duration_s"
            ],
            "properties": {
              "shot_id": {
                "$ref": "#/$defs/id"
              },
              "purpose": {
                "type": "string",
                "minLength": 3
              },
              "role": {
                "enum": [
                  "hook",
                  "establish",
                  "explain",
                  "reveal",
                  "compare",
                  "consequence",
                  "close",
                  "detail",
                  "outro",
                  "transition"
                ],
                "description": "the shot's job on screen (references/screen_grammar.md 4.G); it chooses the pattern section the shot reads (studio pattern show). detail/outro/transition are older names (explain/close/none)"
              },
              "explains": {
                "type": "string"
              },
              "line_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "route_features": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subject_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "pattern": {
                "type": "object",
                "additionalProperties": false,
                "description": "what this shot takes from its role's patterns, carried into this project (aspect, length, subject), and what it leaves on purpose - read with studio pattern show; the departures reach shot.screen.pattern_departs",
                "properties": {
                  "carried": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "item",
                        "why"
                      ],
                      "properties": {
                        "item": {
                          "type": "string",
                          "pattern": "^[a-z_]+$"
                        },
                        "value": {},
                        "why": {
                          "type": "string",
                          "minLength": 8
                        }
                      }
                    }
                  },
                  "departs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "item",
                        "why"
                      ],
                      "properties": {
                        "item": {
                          "type": "string",
                          "pattern": "^[a-z_]+$"
                        },
                        "why": {
                          "type": "string",
                          "minLength": 12
                        }
                      }
                    }
                  }
                }
              },
              "elements": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "description": "world elements this shot shows"
              },
              "beat_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "description": "the world beats this shot tells"
              },
              "direction": {
                "type": "object",
                "additionalProperties": false,
                "description": "How the shot is directed, in words the user reads on the sheet (2026-10-11, the user: \"어떻게 역동적으로 카메라에 담고 ... 배경에는 뭘 넣을지\"): the camera, what the subject does when, what sits in front, middle and back, the size against the shot before, and how it hands over to the next shot",
                "properties": {
                  "camera": {
                    "type": "string",
                    "minLength": 8
                  },
                  "action": {
                    "type": "string",
                    "minLength": 8
                  },
                  "depth": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "fore": {
                        "type": "string"
                      },
                      "mid": {
                        "type": "string"
                      },
                      "back": {
                        "type": "string"
                      }
                    }
                  },
                  "scale_step": {
                    "enum": [
                      "wider",
                      "same",
                      "closer",
                      "first"
                    ]
                  },
                  "transition": {
                    "type": "string"
                  },
                  "reveal": {
                    "enum": [
                      "section_cut",
                      "explode",
                      "transparency",
                      "isolate",
                      "zoom_scale",
                      "real_to_diagram",
                      "time_lapse",
                      "xray",
                      "none"
                    ],
                    "description": "How the shot shows what is inside or hidden (the screen grammar's reveal vocabulary): a section the camera pushes into, an exploded view, see-through skin... The build is measured for it (REVEAL_NOT_SHOWN); a shot list without any is held against the user's reference (REVEAL_UNPLANNED)"
                  }
                }
              },
              "show": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "at",
                    "parts",
                    "how",
                    "why"
                  ],
                  "properties": {
                    "at": {
                      "anyOf": [
                        {
                          "enum": [
                            "start",
                            "end"
                          ]
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      ],
                      "description": "the moment: the start, the end, or a share of the shot (a key picture)"
                    },
                    "parts": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "what this moment must show: part ids of a subject spec, or world element ids"
                    },
                    "how": {
                      "enum": [
                        "exterior",
                        "section",
                        "cutaway",
                        "interior",
                        "explode",
                        "xray",
                        "transparency"
                      ],
                      "description": "how the parts show (studio/blender_ops/show_core.SHOW_METHODS): the picture is drawn this way and the scene builds it"
                    },
                    "min_px": {
                      "type": "integer",
                      "minimum": 8,
                      "description": "how thick each part must show, in output pixels (default: show_core.SHOW_MIN_SHARE of the height)"
                    },
                    "why": {
                      "type": "string",
                      "minLength": 3
                    }
                  }
                },
                "description": "What each moment of the shot shows and how - decided before its pictures (2026-10-13, the user: the picture is drawn as a section from the start; the camera never hunts for an angle)"
              },
              "handover": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "why"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "continue",
                      "match_action",
                      "contrast",
                      "new_place"
                    ]
                  },
                  "why": {
                    "type": "string",
                    "minLength": 3
                  }
                },
                "description": "How this shot hands over to the next: continue (the same subject and motion run on), match_action (one action cut in two), contrast (a deliberate change), new_place (another subject or place)"
              },
              "line_at_s": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "description": "Where each of line_ids starts in the shot, in seconds (same order; the first usually 0). The time between one line's end and the next start is picture alone: a section opening, a mechanism moving (2026-10-12, the user: \"훅훅 넘어가는 느낌\"). Without it the lines follow each other closely."
              }
            }
          }
        }
      }
    },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset"
      ],
      "properties": {
        "preset": {
          "type": "string"
        },
        "per_shot": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "op": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "enum": [
            "set",
            "add",
            "remove"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "value": {}
      }
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "versions"
      ],
      "description": "The rough cut the user watched whole, and the scene version of every shot in it; finals and paid generation render exactly these.",
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": "filled from the cut when left out (a generative shot has no scene version)"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "beats",
        "elements"
      ],
      "description": "The world the video happens in, settled from a picture of every beat before the shot list (studio/world.py): what kind of world it is, its place, light and people, and each element with who makes its shape and its look.",
      "properties": {
        "kind": {
          "enum": [
            "continuous",
            "independent",
            "none"
          ],
          "description": "continuous: one place the shots share (kept alike by a world reference picture); independent: each shot its own place; none: an explanation with no world (a stage tone and light only)"
        },
        "place": {
          "type": "string"
        },
        "time_light": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time_of_day": {
              "type": "string"
            },
            "mood": {
              "type": "string"
            },
            "sun": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "elevation_deg": {
                  "type": "number",
                  "minimum": -10,
                  "maximum": 90
                },
                "azimuth_deg": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              }
            },
            "temperature_k": {
              "type": "number",
              "minimum": 1500,
              "maximum": 20000,
              "description": "the colour of the light that leads (sun, or the lamps of a night interior)"
            },
            "white_balance_k": {
              "type": "number",
              "minimum": 1500,
              "maximum": 20000,
              "description": "the camera white balance; left out, the look decides"
            }
          }
        },
        "inhabitants": {
          "type": "string"
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "beat_id",
              "line_ids",
              "pictures"
            ],
            "properties": {
              "beat_id": {
                "$ref": "#/$defs/id"
              },
              "line_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "description": {
                "type": "string"
              },
              "pictures": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "prompt": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "function",
              "description",
              "owner",
              "why"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "function": {
                "enum": [
                  "subject",
                  "set",
                  "context",
                  "agent",
                  "phenomenon",
                  "light"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 3
              },
              "requirements": {
                "type": "array",
                "items": {
                  "enum": [
                    "exact",
                    "labelled",
                    "motion_bound",
                    "recurring",
                    "far_background"
                  ]
                }
              },
              "owner": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "shape",
                  "look"
                ],
                "properties": {
                  "shape": {
                    "enum": [
                      "blender",
                      "generative"
                    ]
                  },
                  "look": {
                    "enum": [
                      "blender",
                      "generative"
                    ]
                  }
                }
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "scene ids that build this element (its parts or stand-ins), linked once built"
              },
              "why": {
                "type": "string",
                "minLength": 8
              },
              "line_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "description": "the script lines that name this thing (a person, an organisation, another technique, a place): the shots of those lines show it (STORY_ELEMENT_UNSHOWN)"
              }
            }
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "prompt": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
