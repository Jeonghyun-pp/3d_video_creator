{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "brief": {
      "type": "object",
      "properties": {
        "request": {
          "type": "string"
        },
        "key_message": {
          "type": "string"
        },
        "subject_mode": {
          "enum": [
            "specific_real",
            "schematic",
            "fictional"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": [
            "shot",
            "reel"
          ]
        }
      },
      "required": [
        "request",
        "key_message",
        "subject_mode",
        "references",
        "preserve"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "target_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_policy": {
          "enum": [
            "strict",
            "flexible"
          ]
        }
      },
      "required": [
        "width",
        "height",
        "fps",
        "target_seconds",
        "duration_policy"
      ],
      "additionalProperties": false
    },
    "style_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "frame_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "shot_id",
          "start_frame",
          "frame_count"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "say",
            "elevenlabs",
            "external",
            "none"
          ]
        },
        "voice_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "speech_status": {
          "enum": [
            "not_applicable",
            "scratch",
            "final",
            "missing"
          ]
        },
        "settings": {
          "type": "object"
        },
        "previous_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sound"
          ],
          "description": "A music bed under the whole reel (library/sounds, studio sound register): ducked under the narration by sidechain compression, faded in and out, then the mix takes the -16 LUFS target (studio/edit.py sound_mix).",
          "properties": {
            "sound": {
              "type": "string"
            },
            "gain_db": {
              "type": "number",
              "minimum": -40,
              "maximum": 0,
              "description": "default -14"
            },
            "duck_ratio": {
              "type": "number",
              "minimum": 1,
              "maximum": 20,
              "description": "how hard the voice pushes the music down (default 10: about 15-20 dB under speech)"
            },
            "fade_in_s": {
              "type": "number",
              "minimum": 0
            },
            "fade_out_s": {
              "type": "number",
              "minimum": 0
            },
            "start_s": {
              "type": "number",
              "minimum": 0,
              "description": "where in the track to start"
            }
          }
        },
        "speech_share": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 1.0,
          "description": "share of the reel the narration may fill; the rest is picture alone (studio/decisions.SPEECH_SHARE, default 0.72: the user, 2026-10-12, \"훅훅 넘어가는 느낌\")"
        }
      },
      "required": [
        "provider",
        "voice_id",
        "model_id",
        "speech_status"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "look_iterations_per_shot": {
          "type": "integer",
          "minimum": 1
        },
        "motion_iterations_per_shot": {
          "type": "integer",
          "minimum": 1
        },
        "render_wall_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "downloads_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "paid_usd": {
          "type": "number",
          "minimum": 0
        },
        "appearance_iterations_per_shot": {
          "type": "integer",
          "minimum": 1,
          "description": "builds of a shot after its first that chase its concept frame (default 6): the build result says how many remain; spent, list the remaining differences and move on (APPEARANCE_BUDGET_SPENT)"
        }
      },
      "required": [
        "look_iterations_per_shot",
        "motion_iterations_per_shot",
        "render_wall_minutes",
        "downloads_bytes"
      ],
      "additionalProperties": false
    },
    "route_policy": {
      "type": "object",
      "properties": {
        "allow_generative": {
          "type": "boolean"
        },
        "budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "turnaround_required": {
          "type": "boolean"
        }
      },
      "required": [
        "allow_generative",
        "budget_usd",
        "turnaround_required"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "How strictly taste gates judge (studio/gates.py); missing = explain-strict",
      "properties": {
        "strictness": {
          "enum": [
            "explain-strict",
            "look-first",
            "all-strict"
          ]
        },
        "gates": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "error",
              "warn"
            ]
          },
          "propertyNames": {
            "enum": [
              "FILL_LEVEL_EMPTY",
              "FILL_OFF_BRIEF",
              "FILL_SUBJECT_HIDDEN",
              "FRAME_EDGE_CUT",
              "FRAME_SUBJECT_SMALL",
              "GRAPHIC_ILLEGIBLE",
              "KEY_PART_SMALL",
              "KEY_PART_UNDER_UI",
              "REPAIR_BUDGET_EXHAUSTED",
              "SCREEN_SPEED_HIGH",
              "FOCUS_FRAMING",
              "WORLD_LIGHT_CAST",
              "CONTEXT_VOID",
              "SCALE_FLOW_FLAT",
              "FRAME_TARGET_MISS",
              "FRAMING_REPEATED",
              "FRAME_PATH_BLOCKED",
              "FRAME_PICTURE_ABANDONED",
              "FRAME_LAYOUT_MISS",
              "CAMERA_FLAT",
              "CAMERA_HARSH",
              "TAKES_ONE_FEEL",
              "TAKE_RECIPE_DIFFERS",
              "RECIPE_MONOTONE",
              "JOIN_REVERSED",
              "JOIN_STOPPED",
              "JOINS_ROUGH",
              "REVEAL_UNPLANNED",
              "REVEAL_NOT_SHOWN",
              "SCRIPT_DENSE",
              "OPENING_SHORT",
              "SCRIPT_CHOPPY",
              "FRAME_REVIEW_DIFFERS",
              "FRAME_INTENT_DEPARTED",
              "PICTURE3D_CLAIM_UNSEEN",
              "PICTURE3D_STATE_DIFFERS",
              "PICTURE3D_COUNT_DIFFERS",
              "PICTURE_PAINT_SHIFTED",
              "PICTURE_PAINT_DROPPED",
              "PICTURE_PAINT_STATE",
              "PICTURE_PAINT_COUNT",
              "PICTURE_GENERATED_LIMIT",
              "PICTURE_GENERATED",
              "FRAME_TILT_UNREACHED",
              "FRAME_ROLL_LIMITED",
              "SCREEN_PATTERN_OFF",
              "PATTERN_UNREAD",
              "PATTERN_RECORD_REPEATED",
              "MATERIAL_NOT_CATALOG",
              "SCREEN_TARGET_MISSED",
              "detail_placeholder",
              "fidelity_illustrative",
              "fill_ambient_density",
              "fill_identity_kinds",
              "framing",
              "look_camera_dof",
              "look_camera_shake",
              "look_camera_two_point",
              "look_scale",
              "look_target_hidden",
              "subject_margin",
              "subject_trace_illustrative",
              "SUBJECT_UNDECLARED",
              "DETAIL_NOT_SHOWN",
              "MUST_SEE_SHORT",
              "FRAME_MODEL_EDGE",
              "DISPLAY_SCALE_UNDISCLOSED",
              "SUBJECT_SINKS",
              "SHOW_CUT_MISSES",
              "CAMERA_IN_ATMOSPHERE",
              "CAMERA_IN_SUBJECT",
              "ATMOSPHERE_COVERS",
              "FRAME_READING_STALE",
              "FRAME_READING_PARTIAL",
              "FRAME_READING_UNRECORDED",
              "FRAME_TARGET_STALE",
              "FRAME_SUBJECT_MISREAD",
              "FRAME_SIDE_MISS",
              "SUBJECT_END_ON",
              "MOVING_SUBJECT_OFF",
              "FRAME_FLATTENED",
              "STORY_CLIMAX_PLACE",
              "STORY_TENSION_FLAT",
              "STORY_EXPLAIN_RUN",
              "STORY_BEAT_UNSAID",
              "STORY_BEAT_CROWDED",
              "STORY_MISSING",
              "SHELL_MISSING",
              "ENV_SHELL_HELD",
              "ENV_SHELL_DOME_SHORT",
              "ENV_SHELL_GROUND_OUT",
              "ENV_SHELL_CLAY",
              "ENV_SHELL_CLEAR_SHORT",
              "SCALE_REF_MISSING",
              "BLOCKOUT_SIZE_MISSING",
              "STORIES_ONE_IDEA",
              "STORY_PICTURE_MISSING",
              "ESTABLISH_MISSING",
              "ESTABLISH_GAP",
              "SAME_PICTURE",
              "PICTURE_REPEATS",
              "THREAD_DEVICE_UNUSED",
              "CAMERA_OFF_PICTURE_KEPT",
              "OVERFILL_SHARE",
              "STATIC_SHARE_LOW",
              "PACE_SLOW",
              "CLOSE_RUN",
              "ROLE_RUN",
              "REEL_FLOW_PARTIAL",
              "REEL_FLOW_GENERATED",
              "CONCEPTS_ONE_IDEA",
              "HOOK_WEAK",
              "KEY_CHANGE_UNPLANNED",
              "KEY_CHANGE_UNSHOWN",
              "DIRECTION_UNRESOLVED",
              "HEIGHT_FLIP",
              "UNDERFILL_NO_SCALE",
              "SHOT_HOLDS_UNSPOKEN",
              "CLOSE_SHORT",
              "CLIMAX_ONE_SHOT",
              "CLIMAX_NOT_CLOSEST",
              "PART_OCCLUDED",
              "PART_LOW_CONTRAST",
              "CHARACTER_THROUGH_OBJECT",
              "HOOK_ANSWERED_EARLY",
              "QUESTION_DANGLING",
              "STORY_CLOSE_OPEN",
              "STORY_NO_BUT",
              "STORY_LINK_UNSAID",
              "STORY_CHAIN_UNSET",
              "TURN_SPOKEN_ONLY",
              "STORY_TOUR",
              "STAKE_MISSING",
              "STAKE_NOT_CLOSED",
              "CLOSE_NOT_RETURNING",
              "STORY_STAKE_UNSET",
              "STORY_LOSES",
              "CUT_UNTOLD",
              "KEEPS_NOT_READ",
              "KEEP_UNBUILT",
              "SCENE_BEHIND_SHOT",
              "THREAD_OFF_SCREEN"
            ]
          },
          "description": "per-gate severity override; only gates studio/gates.py SOFTENABLE lists may be softened"
        },
        "explain_generated": {
          "enum": [
            "gate",
            "pick_without_overlays"
          ],
          "description": "gate: an explain shot uses a generated take only when it passed the structure gate; pick_without_overlays: also when the user picks it and the shot has no labels or graphics"
        },
        "viewpoint_cheat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "user_words"
          ],
          "description": "the user left the camera's lens and angle to the agent (studio/cheat_core.viewpoint_policy): a view or lens cheat, or a viewpoint departure (frames depart --item angle|tilt), needs no words per shot - still shown on the sheet and counted against the departure limit",
          "properties": {
            "by": {
              "enum": [
                "agent"
              ]
            },
            "user_words": {
              "type": "string",
              "minLength": 4,
              "description": "the user's own words that gave it"
            },
            "at": {
              "type": "string",
              "description": "when it was recorded (studio project viewpoint-cheat)"
            }
          }
        },
        "generate_only_max": {
          "type": "integer",
          "minimum": 0,
          "description": "shots of the reel that may be drawn from text only, without 3D (studio/picture3d.generate_only); missing = GENERATE_ONLY_MAX"
        }
      }
    },
    "decision_ladder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adopted_at"
      ],
      "description": "Set when the project first proposes a decision (studio/decisions.py): from then on a missing decisions/ladder.json is drift, not a legacy project",
      "properties": {
        "adopted_at": {
          "type": "string"
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_words",
        "recorded_at"
      ],
      "description": "The user handed the run's decisions to the agent (studio/decisions.py delegate): no decision-ladder sheets; the agent decides what is not on the ask-only list and records it with `decide note`. Recorded only from the user's own words (project delegate / the launcher's --delegate).",
      "properties": {
        "user_words": {
          "type": "string",
          "minLength": 4
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional topics the delegation covers (empty: everything outside the ask-only list)"
        },
        "recorded_at": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "brief",
    "output",
    "style_id",
    "shots",
    "claims",
    "audio",
    "limits"
  ],
  "additionalProperties": false
}
