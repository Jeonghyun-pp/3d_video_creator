  "contact_kinds_why": "How a held thing keeps to its holder, by kind: each row names the measures of studio2/video_parts.contact it keeps (apart: the gap between the two boxes; outside: the held box's share outside the holder's; drift: how far it moved against the holder since the hold began; gone: one of the pair vanishing while the other is shown). A hold of the plan names its kind (video.holds: {says, held, holder, kind, at}); a new kind of contact is a row here, never code.",
  "contact_kinds": {
    "carried": {
      "means": "held, gripped, carried or hanging from the holder: it stays against the holder and keeps its place on it",
      "example": "a box hanging under a rail vehicle; a jar in a robot gripper; a container on a crane spreader",
      "keeps": [
        "apart",
        "drift",
        "gone"
      ]
    },
    "inside": {
      "means": "in the holder - a box, a slot, the jaws of a hoist: it stays within the holder's outline and keeps its place in it",
      "example": "wafers in their box's slots; a box gripped up inside a hoist",
      "keeps": [
        "outside",
        "drift",
        "gone"
      ]
    },
    "rides": {
      "means": "rides or rests on the holder and may move along it: it stays against it",
      "example": "a rail vehicle on its rail; a car on a road; a box on a conveyor belt",
      "keeps": [
        "apart",
        "gone"
      ]
    }
  },
